{
  "rewrites": [
    { "source": "/s", "destination": "/api/index" },
    { "source": "/spublic", "destination": "/api/index" },
    { "source": "/sprivate", "destination": "/api/index" },
    { "source": "/api/(.*)", "destination": "/api/index" }
  ],
  "headers": [
    {
      "source": "/(s|spublic|sprivate)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
