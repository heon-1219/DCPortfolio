# Scheduler configuration — copy to .env.local for local runs.
# Real values live in the Vercel dashboard. NEVER commit filled-in secrets.

# Neon Postgres pooled connection string
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# Random string used to sign session cookies.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Page passcodes. Deliberately env-driven, never hardcoded.
SCHEDULER_PASSWORD=
SPRIVATE_PASSWORD=

# Telegram reminder bot (a NEW bot, not heonbot's token)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
